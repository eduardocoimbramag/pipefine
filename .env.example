# =============================================================================
# Pipefine — Variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha com os valores do seu projeto.
# Encontre estes valores em: Supabase Dashboard > Project Settings > API
# =============================================================================

# URL pública do projeto Supabase (ex.: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "anon" (pode ser exposta no client — protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave SECRETA "service_role" (NUNCA exponha no client — ignora o RLS).
# Usada só no servidor pelo rate limiting do login (tabela login_attempts).
# Encontre em: Supabase Dashboard > Project Settings > API > service_role.
# Se ficar vazia, o login funciona normalmente, porém SEM o limite de tentativas.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Controle de acesso (quem pode CRIAR conta)
# -----------------------------------------------------------------------------
# Lista de e-mails autorizados a se cadastrar pela tela "Criar conta",
# separados por vírgula. Apenas estes e-mails conseguem criar login.
# Deixe vazio para FECHAR completamente o cadastro de novas contas.
# NÃO tem NEXT_PUBLIC_ — fica só no servidor, nunca exposto no navegador.
# Exemplo:
#   ALLOWED_SIGNUP_EMAILS=voce@gmail.com, mae@gmail.com, irma@gmail.com
ALLOWED_SIGNUP_EMAILS=
